[
  {
    "id": "upstream-only-modification",
    "base": "policy=old\n",
    "local": "policy=old\n",
    "upstream": "policy=new\n",
    "expect_conflict": false,
    "must_include": ["policy=new"]
  },
  {
    "id": "local-only-modification",
    "base": "policy=old\n",
    "local": "policy=local\n",
    "upstream": "policy=old\n",
    "expect_conflict": false,
    "must_include": ["policy=local"]
  },
  {
    "id": "preserve-local-and-apply-upstream",
    "base": "consumer=base\nkeep=1\nkeep=2\nkeep=3\nkeep=4\npolicy=old\n",
    "local": "consumer=preserve\nkeep=1\nkeep=2\nkeep=3\nkeep=4\npolicy=old\n",
    "upstream": "consumer=base\nkeep=1\nkeep=2\nkeep=3\nkeep=4\npolicy=new\n",
    "expect_conflict": false,
    "must_include": ["policy=new", "consumer=preserve"]
  },
  {
    "id": "conflicting-modification",
    "base": "policy=old\n",
    "local": "policy=local\n",
    "upstream": "policy=upstream\n",
    "expect_conflict": true,
    "must_include": ["policy=local", "policy=upstream"]
  },
  {
    "id": "upstream-adds-managed-file",
    "base": null,
    "local": null,
    "upstream": "new=managed\n",
    "expect_conflict": false,
    "must_include": ["new=managed"]
  },
  {
    "id": "upstream-deletes-managed-file",
    "base": "old=managed\n",
    "local": "old=managed\n",
    "upstream": null,
    "expect_conflict": false,
    "must_include": []
  },
  {
    "id": "local-modification-upstream-deletion",
    "base": "old=managed\n",
    "local": "old=customized\n",
    "upstream": null,
    "expect_conflict": true,
    "must_include": ["old=customized"]
  }
]
