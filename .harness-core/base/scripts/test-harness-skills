#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if [[ ${1:-} == "--release-baseline" ]]; then
  shift
  set -- --require-pristine-baseline "$@"
fi
python3 "$root/scripts/validate-harness-sdlc.py" "$@"
python3 "$root/tests/harness/test-sync-harness-source.py"
exec python3 "$root/tests/harness/test-system-log-tracer.py"
